# Apache / ALL-INKL. Enable the certificates in KAS before publishing.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^starwarsccg\.de$ [NC]
  RewriteRule ^ https://www.starwarsccg.de%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.starwarsccg\.de$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.starwarsccg.de%{REQUEST_URI} [R=301,L]
</IfModule>

<FilesMatch "(^\.|^local-print-texts\.json$|^premiere-drucktexte-lokal\.json$)">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/plain image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cache-Control "no-cache"
  <FilesMatch "\.[a-f0-9]{12}\.(js|json|css|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
